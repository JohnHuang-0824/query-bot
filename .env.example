# 複製成 .env 再填。.env 已經在 .gitignore 裡，不要拿掉。
#
# ⚠️ TOKEN 外洩等於任何人都能用你的 bot 身分說話。
#    真的外洩就去 Developer Portal 直接 Reset Token，不要只是刪掉檔案。
#    （小小的好消息：token 若被 commit 到 GitHub，Discord 會自動偵測並失效。）

# --- Discord Developer Portal → 你的 Application ---

# Bot → Token。只會顯示一次，關掉就要重設
TOKEN=

# General Information → Application ID
CLIENT_ID=

# --- 測試伺服器 ---

# 你自己的私人測試伺服器 ID（右鍵伺服器 → 複製伺服器 ID，需先開開發者模式）
#
# 標了 experimental: true 的指令**只會註冊到這個伺服器**，不會全域公開。
# 開發 /ruling 期間一律掛 experimental，這是上游內建的隔離機制。
GUILD_ID=

# --- 管理者 ---

# 你自己的 Discord 使用者 ID。
# bot.js 用它判斷誰可以觸發指令重新註冊（deploy_command）。
ADMIN=

# --- Gemini（第 4 階段：繁中解釋層）---

# ⚠️ **另開一個 Google Cloud 專案**，不要跟其他專案共用。
#    共用的話兩邊會互撞免費層的 RPM/RPD 限流，而且事後分不清是誰燒掉的。
#    （架構決策第四節）
GEMINI_API_KEY=

# 用哪個模型。⚠️ 釘死版本，不要用 -latest 那種別名 —— 別名會在你不知情時
#   換掉背後的模型，於是評測結果變了卻找不到原因。
#   實測 gemini-3-flash 不存在（是 gemini-3-flash-preview）；preview 會被下架，
#   所以預設用 GA 的 2.5-flash。要換就改這裡再跑一次評測，用數字比較。
GEMINI_MODEL=gemini-2.5-flash

# 速率上限。⚠️ **以 429 回應裡的 quotaValue 為準，不要照文件填。**
#   2026-09-16 實測 gemini-2.5-flash 免費層：
#     quotaId GenerateRequestsPerDayPerProjectPerModel-FreeTier = 20／天
#   文件寫的是 1500，差 75 倍。填錯的後果是自己的節流永遠不跳，
#   直接撞對方的 429，而症狀看起來像「模型答不出來」。
#   要確認現在的真實數字：撞到 429 時看錯誤訊息裡的「配額：」那段。
#   一題 = 2 次呼叫，所以 20 ⇒ 全服每天 10 題。開付費層後再往上調。
GEMINI_RPD=20
GEMINI_RPM=10

# 每人每日提問上限。預設 3（= 6 次呼叫），配合上面的 20。
ASK_PER_USER_PER_DAY=3
